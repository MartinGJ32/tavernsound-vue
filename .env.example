# ── Variables PÚBLICAS ──
# Cualquier variable con prefijo VITE_ queda embebida en el bundle del
# cliente y es visible para cualquier usuario. Nunca pongas un secreto acá.
#
# (Por ahora no hay ninguna: la app arma las URLs de /api/* y la conexión
# de Socket.io contra el mismo origen que sirvió la página — no hace
# falta una variable de entorno para eso, ver vite.config.ts.)

# ── Variables PRIVADAS (solo el servidor) ──
# Estas NO llevan prefijo VITE_ a propósito: Vite no las expone al bundle.
# En producción (OCI) se configuran como variables de entorno del proceso
# (systemd, PM2, o el mecanismo que se elija en la Fase 9), nunca se
# commitean con valores reales.

# NODE_ENV no va acá: en la nube lo fija la unidad de systemd
# (deploy/tavernsound.service) y en local lo ponés vos en el shell cuando
# querés simular producción. Ver LOCAL-VS-NUBE.md.

# Puerto en el que escucha server/index.ts. 3000 por default si se deja vacío.
PORT=3000

# Milisegundos que se espera después de que el host se desconecta antes
# de reasignar el rol a otro oyente — protege contra que un simple
# refresh de página (que desconecta y reconecta en menos de un segundo)
# le haga perder el rol al host. 5000 por default si se deja vacío.
HOST_REASSIGNMENT_GRACE_MS=5000

# Cuántas salas puede crear una misma IP cada 10 minutos. 10 por default.
CREATE_ROOM_LIMIT=10

# Credenciales de Redis para persistir el estado de cada sala, provistas
# por Upstash (funciona igual desde cualquier hosting, no es específico
# de Vercel — accedido vía REST, no vía el protocolo nativo de Redis).
# Si las dejás vacías, la app cae automáticamente a un store en memoria
# (ver server/lib/roomStore.ts) — útil para desarrollar sin una base
# real, pero sin persistencia entre reinicios del proceso.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
