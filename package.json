{
  "name": "tavernsound",
  "version": "0.1.0",
  "private": true,
  "description": "TavernSound — escuchá música sincronizada con amigos, en salas.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:legacy": "npm --prefix legacy run start",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b --noEmit",
    "start:server": "tsx server/index.ts",
    "test": "vitest run",
    "diagnose": "tsx server/diagnose.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pinia": "^4.0.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
